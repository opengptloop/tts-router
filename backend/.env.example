# Copy to .env (or export these) to customize the backend.

# Where models, voices, audio and logs live (default: ./data)
# TTS_DATA_DIR=/absolute/path/to/data

# Bind address (default 127.0.0.1:8000)
# TTS_HOST=0.0.0.0
# TTS_PORT=8000

# Comma separated CORS origins, default * (needed only when the frontend is
# served from a different origin; the Vite proxy makes this unnecessary in dev)
# TTS_CORS_ORIGINS=http://localhost:5173

# Piper voice catalogue refresh interval in seconds (default 7 days)
# TTS_PIPER_CATALOG_TTL=604800
